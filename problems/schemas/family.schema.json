{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bespokelabsai/conjecture-bench/problems/schemas/family.schema.json",
  "title": "ConjectureBench problem family",
  "type": "object",
  "required": ["schema_version", "source", "retrieved", "records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "retrieved": {"type": "string", "format": "date"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "title",
          "field",
          "statement",
          "parameters",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "class": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 3},
          "field": {"type": "string", "minLength": 2},
          "statement": {"type": "string", "minLength": 10},
          "parameters": {"type": "object"},
          "status": {
            "type": "object",
            "required": ["state", "as_of"],
            "properties": {
              "state": {"const": "open"},
              "as_of": {"type": "string", "format": "date"},
              "source_label": {"type": "string"}
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "object",
            "required": ["url", "quote"],
            "properties": {
              "url": {"type": "string", "format": "uri"},
              "quote": {"type": "string", "minLength": 5}
            },
            "additionalProperties": false
          },
          "frontier": {"type": "object", "minProperties": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
