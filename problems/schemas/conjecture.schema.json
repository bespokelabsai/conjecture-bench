{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bespokelabsai/conjecture-bench/problems/schemas/conjecture.schema.json",
  "title": "ConjectureBench curated conjecture",
  "type": "object",
  "required": [
    "format_version",
    "id",
    "slug",
    "title",
    "field",
    "statement",
    "counterexample",
    "status_observation",
    "provenance"
  ],
  "properties": {
    "format_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^cb-[0-9]{4,}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 3},
    "field": {"type": "string", "minLength": 2},
    "statement": {"type": "string", "minLength": 10},
    "counterexample": {
      "type": "object",
      "required": ["description", "finite"],
      "properties": {
        "description": {"type": "string", "minLength": 10},
        "finite": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "status_observation": {
      "type": "object",
      "required": ["state", "as_of", "evidence_state"],
      "properties": {
        "state": {"enum": ["open", "status-contested"]},
        "as_of": {"type": "string", "format": "date"},
        "evidence_state": {
          "enum": [
            "source-linked",
            "maintainer-listed",
            "needs-independent-review"
          ]
        },
        "note": {"type": "string", "minLength": 10}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "status-contested"}}},
          "then": {"required": ["note"]}
        }
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["collection", "sources"],
      "properties": {
        "collection": {"type": "string", "minLength": 1},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["url", "role"],
            "properties": {
              "url": {"type": "string", "format": "uri"},
              "role": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "discovery_records": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "equivalence_group": {"type": "string", "minLength": 1},
    "duplicate_of": {"type": "string", "pattern": "^cb-[0-9]{4,}$"}
  },
  "additionalProperties": false
}
