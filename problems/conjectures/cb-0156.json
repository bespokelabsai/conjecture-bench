  "slug": "topp-38-compatible-triangulations",
  "title": "Compatible triangulations",
  "field": "computational-geometry",
  "statement": "Any two general-position planar n-point sets with equal convex-hull size have combinatorially compatible triangulations.",
  "counterexample": {
    "description": "Two rational seven-point sets, each with a triangular convex hull and four interior points, for which exhaustive straight-line triangulation catalogs have no isomorphic face lattices.",
