  "slug": "union-closed-tight-cardinality",
  "title": "Tight union-closed family cardinality conjecture",
  "field": "extremal-set-theory",
  "statement": "If every ground-set element of a nontrivial union-closed family occurs in exactly half its members, then the family has 2^k members for some k.",
  "counterexample": {
    "description": "A finite union-closed family in which every used element has frequency exactly |F|/2 but |F| is not a power of two.",
    "finite": true
  },
