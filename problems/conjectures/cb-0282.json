  "id": "cb-0282",
  "slug": "serial-symmetric-exchanges",
  "title": "Kotlar–Ziv serial symmetric exchange conjecture",
  "field": "matroid-theory",
  "statement": "For any two bases A and B of a matroid and every subset X of A, there is an equally sized subset Y of B and orderings of X and Y such that, after every paired prefix exchange, both resulting sets are bases.",
  "counterexample": {
    "description": "Two disjoint labeled bases of a rank-five or rank-six vector matroid over an odd prime field, together with a prescribed subset X of at least three elements, for which exhaustive search finds no serial symmetric exchange.",
    "finite": true
  },
