  "slug": "cyclic-orderings-of-matroids",
  "title": "Cyclic ordering conjecture for matroids",
  "field": "matroid-theory",
  "statement": "If the ground set of a finite matroid can be partitioned into k disjoint bases, then its elements have a cyclic ordering in which every rank-many consecutive elements form a basis.",
  "counterexample": {
    "description": "Two labeled bases of a rank-six vector matroid over a prime field for which exhaustive search finds no cyclic ordering whose six-element windows are all bases.",
    "finite": true
  },
