  "title": "Scholz–Brauer addition-chain conjecture",
  "field": "number-theory",
  "statement": "For every n≥1, the shortest addition-chain length for 2ⁿ−1 is at most n−1 plus the shortest addition-chain length for n.",
  "counterexample": {
    "description": "An integer n for which exact exhaustive addition-chain searches prove l(2^n−1)>n−1+l(n).",
    "finite": true
  },
