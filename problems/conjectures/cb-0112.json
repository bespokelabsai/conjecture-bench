  "slug": "rotas-basis-conjecture",
  "title": "Rota’s basis conjecture",
  "field": "matroid-theory",
  "statement": "If the ground set of a rank-n matroid is partitioned into n bases, those elements can be rearranged into n disjoint transversal bases.",
  "counterexample": {
    "description": "Five or six labeled bases of a rank-n vector matroid over a prime field F_p for which exhaustive transversal-basis exact cover finds no rearrangement into n disjoint rainbow bases.",
    "finite": true
  },
