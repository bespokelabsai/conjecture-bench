  "slug": "strong-sensitivity",
  "title": "Strong sensitivity conjecture",
  "field": "computational-complexity",
  "statement": "Every Boolean function f:{0,1}ⁿ→{0,1} has block sensitivity bs(f) at most the square of its sensitivity s(f).",
  "counterexample": {
    "description": "A complete Boolean truth table, an input, and more than s(f)² pairwise disjoint blocks whose individual flips all change the function at that input.",
    "finite": true
  },
