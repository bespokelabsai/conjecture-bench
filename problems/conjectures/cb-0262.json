  "slug": "agrawal-polynomial-congruence",
  "title": "Agrawal polynomial-congruence conjecture",
  "field": "computational-number-theory",
  "statement": "Let n>1 and let r be a prime not dividing n. If (X−1)^n ≡ X^n−1 in (ℤ/nℤ)[X]/(X^r−1), then n is prime or n² ≡ 1 (mod r).",
  "counterexample": {
    "description": "A composite n and prime r not dividing n for which n² is not 1 modulo r but the stated cyclic polynomial congruence holds exactly.",
    "finite": true
  },
