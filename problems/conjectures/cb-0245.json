  "slug": "new-mersenne-conjecture",
  "title": "New Mersenne conjecture",
  "field": "number-theory",
  "statement": "For every odd natural number p, if any two of these hold—2^p−1 is prime, (2^p+1)/3 is prime, or p=2^k±1 or 4^k±3 for some k—then all three hold.",
  "counterexample": {
    "description": "An odd p for which deterministic primality tests and exact special-form enumeration show that exactly two of the three conditions hold.",
    "finite": true
  },
