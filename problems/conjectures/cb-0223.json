  "title": "Sun's 1680 four-square conjecture",
  "field": "additive-number-theory",
  "statement": "Every nonnegative integer n can be written as n=x²+y²+z²+w² for nonnegative integers x,y,z,w such that x⁴+1680y³z is a square.",
  "counterexample": {
    "description": "A nonnegative integer n for which exhaustive integer-root search finds no four-square representation satisfying the 1680 square condition.",
