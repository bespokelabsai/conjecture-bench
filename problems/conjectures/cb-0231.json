  "title": "Sun's square-plus-one primitive-root conjecture",
  "field": "number-theory",
  "statement": "For every prime p, there is an integer k such that k²+1<p and k²+1 is a primitive root modulo p.",
  "counterexample": {
    "description": "A prime p for which exhaustive checking finds no integer k with k²+1<p and multiplicative order p−1 modulo p.",
