  "title": "Dubner twin-prime sum conjecture",
  "field": "number-theory",
  "statement": "Every even integer greater than 4208 is the sum of two primes that each belong to a twin-prime pair.",
  "counterexample": {
    "description": "An even integer n>4208 for which exhaustive exact sieving finds no decomposition n=p+q with p and q each having a prime neighbor at distance two.",
