  "id": "cb-0286",
  "slug": "common-independent-set-cover",
  "title": "Aharoni–Berger common-independent-set covering conjecture",
  "field": "matroid-theory-and-combinatorial-optimization",
  "statement": "For a loopless matroid M let Δ(M)=max over nonempty X of |X|/r_M(X). The common ground set of any two loopless matroids M₁ and M₂ can be partitioned into at most ceil(max(Δ(M₁),Δ(M₂)))+1 sets that are independent in both matroids.",
  "counterexample": {
    "description": "Two loopless prime-field vector matroids whose exact individual density bound is at most four but whose exact common-independent cover number exceeds the conjectured maximum individual chromatic number plus one.",
    "finite": true
  },
