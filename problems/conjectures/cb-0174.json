  "slug": "aharoni-berger-rainbow-matching-conjecture",
  "title": "Aharoni–Berger rainbow-matching conjecture",
  "field": "graph-theory",
  "statement": "Every family of n matchings of size n+1 in a bipartite multigraph has a rainbow matching of size n.",
  "counterexample": {
    "description": "A bipartite multigraph represented by n colour classes, each a matching of size n+1, for which no pairwise vertex-disjoint choice uses every colour.",
    "finite": true
  },
