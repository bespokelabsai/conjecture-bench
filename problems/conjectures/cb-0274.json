  "slug": "small-quasi-kernel",
  "title": "Small quasi-kernel conjecture",
  "field": "directed-graph-theory",
  "statement": "Every finite loopless sink-free digraph D has an independent vertex set Q of size at most |V(D)|/2 such that every vertex of D can reach Q by a directed path of length at most two.",
  "counterexample": {
    "description": "A finite loopless digraph in which every vertex has positive out-degree but no independent set of at most floor(n/2) vertices is reachable from every vertex within two directed steps.",
    "finite": true
  },
