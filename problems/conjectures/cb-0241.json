  "slug": "unique-crystal-components",
  "title": "Unique crystal components conjecture",
  "field": "number-theory",
  "statement": "If an odd n has a factorization n=ab with a,b>1 and ((a+b)²+(ab+1)²)/(2(a+1)(b+1)) integral, then the unordered component pair {a,b} is unique.",
  "counterexample": {
    "description": "An odd n with two distinct unordered factor pairs {a,b} and {c,d}, each satisfying the exact crystal divisibility condition.",
    "finite": true
  },
