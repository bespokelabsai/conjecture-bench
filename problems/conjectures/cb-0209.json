  "title": "Unfair zero–one polynomial conjecture",
  "field": "algebra-and-probability",
  "statement": "If two monic real polynomials with nonnegative coefficients have a product whose coefficients are all 0 or 1, then every coefficient of each factor is itself 0 or 1.",
  "counterexample": {
    "description": "Two monic polynomials with nonnegative rational coefficients whose exact product is zero–one although at least one factor has a coefficient outside {0,1}.",
