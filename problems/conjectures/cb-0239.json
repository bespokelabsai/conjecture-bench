  "title": "Arithmetic sum S greater-than-3k conjecture",
  "field": "number-theory",
  "statement": "For every odd prime k>3119, S(k)>3k, where S(k)=∑_{h=1}^{k−1}∑_{j=1}^{k−1}(−1)^(j+1+⌊hj/k⌋).",
  "counterexample": {
    "description": "An odd prime k>3119 for which exact evaluation gives S(k)≤3k.",
    "finite": true
  },
