  "slug": "kriesell-two-steiner-trees",
  "title": "Kriesell’s Steiner-tree packing conjecture",
  "field": "graph-theory-and-combinatorial-optimization",
  "statement": "If a terminal set T in a finite graph is 2k-edge-connected, then the graph contains k pairwise edge-disjoint Steiner trees spanning T.",
  "counterexample": {
    "description": "A finite simple graph with at least six terminals that are 4-edge-connected but admit no two edge-disjoint Steiner trees.",
