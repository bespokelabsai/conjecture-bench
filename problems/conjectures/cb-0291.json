  "slug": "baker-graph-gonality",
  "title": "Baker’s graph-gonality conjecture",
  "field": "graph-divisor-theory-and-chip-firing",
  "statement": "Every finite connected graph G of genus g=|E(G)|−|V(G)|+1 has divisorial gonality gon(G)≤⌊(g+3)/2⌋; equivalently, G has an integer divisor of degree at most ⌊(g+3)/2⌋ and rank at least one.",
  "counterexample": {
    "description": "A finite simple connected graph for which exact chip-firing class arithmetic proves that no divisor through Baker’s conjectural degree bound has positive rank.",
    "finite": true
  },
