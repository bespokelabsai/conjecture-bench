  "slug": "antihydra-nonnegative-condition",
  "title": "Antihydra nontermination conjecture",
  "field": "dynamical-systems-and-computability",
  "statement": "Let a₀=8 and aₙ₊₁=⌊3aₙ/2⌋. Starting from b₀=0, add 2 to b after each even aₙ and subtract 1 after each odd aₙ. Then bₙ is nonnegative for every n.",
  "counterexample": {
    "description": "A positive index n at which exact recurrence simulation gives bₙ<0, equivalently more than twice as many odd as even terms among a₀,…,aₙ₋₁.",
    "finite": true
  },
