    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 5 11]\ntheorem green_31.variants.zmod_p : answer(sorry) ↔\n    ∃ S : (n : ℕ) → Finset (ZMod n),\n    ∃ o : ℕ → ℝ,\n      (o =o[atTop] fun _ : ℕ ↦ (1 : ℝ)) ∧\n      (∀ p, p.Prime → IsSidon (S p : Set (ZMod p))) ∧\n      (∀ p, p.Prime → ((S p).card : ℝ) = (1 + o p) * Real.sqrt (p : ℝ))",
