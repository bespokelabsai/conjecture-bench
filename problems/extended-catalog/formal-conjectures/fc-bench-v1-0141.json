    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 5]\ntheorem erdos_184 :\n    ∃ f : ℕ → ℝ,\n      (f =O[atTop] fun n : ℕ ↦ (n : ℝ)) ∧\n      ∀ {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V),\n      ∃ (D : Finset G.Subgraph),\n        (∀ H ∈ D, IsCycleOrEdge H.coe) ∧\n        IsDecomposition G D ∧\n        (D.card : ℝ) ≤ f (Fintype.card V)",
