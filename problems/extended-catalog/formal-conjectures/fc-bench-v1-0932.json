  "title": "lonely_runner_conjecture",
  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 11]\ntheorem lonely_runner_conjecture (n : ℕ)\n    (speed : Fin n ↪ ℝ) (lonely : Fin n → ℝ → Prop)\n    (lonely_def :\n      ∀ r t, lonely r t ↔\n        ∀ r2 : Fin n, r2 ≠ r →\n        dist (t * speed r : UnitAddCircle) (t * speed r2) ≥ 1 / n)\n    (r : Fin n) : ∃ t ≥ 0, lonely r t",
