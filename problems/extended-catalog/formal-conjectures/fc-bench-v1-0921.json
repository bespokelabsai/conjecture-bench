  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 11]\ntheorem lander_parkin_selfridge :\n    ∀ (k n m : ℕ) (x : Fin n → ℕ) (y : Fin m → ℕ),\n      (∀ i, 0 < x i) → (∀ j, 0 < y j) →\n      (∀ i j, x i ≠ y j) →\n      ∑ i, x i ^ k = ∑ j, y j ^ k →\n      k ≤ n + m",
