    "text": "@[category research open, AMS 5]\ntheorem erdos_701 {X : Type*} [Nonempty X] :\n    ∀ (F : Set (Set X)), IsLowerSet F →\n      ∃ x : X, ∀ᵉ (F' ⊆ F),\n        F'.Intersecting →\n          (#F' ≤ #{ A : Set X | A ∈ F ∧ x ∈ A })",
