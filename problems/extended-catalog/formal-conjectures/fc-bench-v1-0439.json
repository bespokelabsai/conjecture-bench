  "title": "erdos_695.variants.upperBound",
  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 11]\ntheorem erdos_695.variants.upperBound : answer(sorry) ↔\n    ∃ q : ℕ → ℕ,\n      StrictMono q ∧\n      (∀ i, (q i).Prime) ∧\n      (∀ i, q (i + 1) % q i = 1) ∧\n      ∃ o : ℕ → ℝ,\n        (o =o[atTop] (1 : ℕ → ℝ)) ∧\n        -- We use `(k + 1)` here as the informal statement is 1-indexed.\n        ∀ k, q k ≤ exp ((k + 1) * log (k + 1) ^ (1 + o k))",
