  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 11]\ntheorem erdos_1210 :\n  answer(sorry) ↔\n    ∃ C : ℝ, ∀ n : ℕ, ∀ A : Finset ℕ,\n      (∀ a ∈ A, 1 ≤ a ∧ a < n) →\n      (∀ a ∈ A, ∀ b ∈ A, a ≠ b → a.Coprime b) →\n      ∑ a ∈ A, (1 / ((n : ℝ) - a)) ≤ (∑ p ∈ (range n).filter Prime, (1 / (p : ℝ))) + C",
