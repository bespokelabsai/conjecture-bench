  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 11]\ntheorem pillais_conjecture (a b c : ℕ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) :\n    { (x, y, m, n) : (ℕ × ℕ × ℕ × ℕ) |\n      1 < x ∧ 1 < y ∧ 1 < m ∧ 1 < n ∧ (m, n) ≠ (2, 2) ∧\n      a * x^n - b * y^m = c }.Finite",
