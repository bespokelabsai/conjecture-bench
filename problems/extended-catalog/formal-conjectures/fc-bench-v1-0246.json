    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 11]\ntheorem erdos_341 :\n    answer(sorry) ↔\n      ∀ (a : ℕ → ℤ),\n        (∀ᶠ n in atTop,\n          IsLeast { x | a n < x ∧ x ∉ { a i + a j | (i ≤ n) (j ≤ n) } } (a (n + 1))) →\n        let d := fun i ↦ a (i + 1) - a i\n        ∃ p > 0, ∀ᶠ m in atTop, d (m + p) = d m",
