  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 11]\ntheorem erdos_szekeres_strengthening : answer(sorry) ↔\n    ∃ E : Finset (ℕ × ℕ × ℕ), ∀ n i j : ℕ,\n      1 ≤ i →\n      i < j →\n      j ≤ n / 2 →\n      (n, i, j) ∉ E →\n      ∃ p : ℕ, p.Prime ∧ i < p ∧ p ∣ Nat.gcd (Nat.choose n i) (Nat.choose n j)",
