  "title": "pierce_birkhoff_conjecture",
  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 13]\ntheorem pierce_birkhoff_conjecture {n : ℕ} (f : (Fin n → ℝ) → ℝ)\n    (hf : IsPiecewiseMvPolynomial f) :\n    ∃ (ι κ : Type) (g : ι → κ → MvPolynomial (Fin n) ℝ), Finite ι ∧ Finite κ ∧\n      ∀ x, f x = ⨆ i, ⨅ j, MvPolynomial.eval x (g i j)",
