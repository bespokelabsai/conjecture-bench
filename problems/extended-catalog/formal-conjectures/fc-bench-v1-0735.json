  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 5 11 68]\ntheorem beaver_math_olympiad_problem_2_antihydra\n    (a : ℕ → ℕ) (b : ℕ → ℤ)\n    (a_ini : a 0 = 8)\n    (a_rec : ∀ n, a (n + 1) = (3 * a n) / 2)\n    (b_ini : b 0 = 0)\n    (b_rec : ∀ n, b (n + 1) = if a n % 2 = 0 then b n + 2 else b n - 1) :\n    ∀ n, b n ≥ 0",
