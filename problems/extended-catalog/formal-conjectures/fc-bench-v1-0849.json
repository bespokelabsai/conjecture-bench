  "title": "determinantal_conjecture",
  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 15]\ntheorem determinantal_conjecture\n    (n : Type) [Fintype n] [DecidableEq n]\n    (d1 d2 : n → ℂ) (U1 U2 : unitary (Matrix n n ℂ)) :\n    (U1 * Matrix.diagonal d1 * star U1 + U2 * Matrix.diagonal d2 * star U2).det\n      ∈ convexHull ℝ { ∏ i, (d1 i + d2 (σ i)) | σ : Equiv.Perm n }",
    "language_version": "Lean 4.27.0",
