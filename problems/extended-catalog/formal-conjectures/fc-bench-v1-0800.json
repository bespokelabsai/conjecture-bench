  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 5]\ntheorem reed_omega_delta_chi_conjecture :\n  ∀ {V : Type} (G : SimpleGraph V),\n    let χ := G.chromaticNumber\n    let ω := G.ecliqueNum\n    let Δ := G.emaxDegree\n    2 * χ ≤ ω + Δ + 2",
