  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 5 11]\ntheorem erdos_865 :\n    ∃ C > 0, ∀ᶠ (N : ℕ) in atTop,\n      ∀ A ⊆ Icc 1 N, A.card ≥ (5 / 8 : ℝ) * N + C →\n      ∃ a ∈ A, ∃ b ∈ A, ∃ c ∈ A, a ≠ b ∧ a ≠ c ∧ b ≠ c ∧\n      a + b ∈ A ∧ a + c ∈ A ∧ b + c ∈ A",
