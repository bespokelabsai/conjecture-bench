    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 11]\ntheorem erdos_1002 :\n    answer(sorry) ↔\n      ∃ g : ℝ → ℝ, Monotone g ∧\n      Tendsto g atBot (𝓝 0) ∧\n      Tendsto g atTop (𝓝 1) ∧\n      letI f :=  fun (α : ℝ) (n : ℕ) ↦\n        (1 / log n) * ∑ k ∈ Icc (1 : ℕ) n, (1 / 2 - Int.fract (α * k))\n      ∀ c : ℝ, Tendsto (fun (n : ℕ) ↦ (volume { α | α ∈ Ioo (0 : ℝ) 1 ∧ f α n ≤ c }).toReal)\n        atTop (𝓝 (g c))",
