  "title": "independentDominationOdd",
  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 5]\ntheorem independentDominationOdd (hIso : 0 < G.minDegree) (hOdd : Odd G.maxDegree) :\n    let D := G.maxDegree\n    let i := G.indepDominationNumber\n    let n := Fintype.card V\n    (D + 1) * (D + 3) * i ≤ (D^2 + 3) * n",
