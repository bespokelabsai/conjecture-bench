  "title": "rank_height_count_asymptotic",
  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 11 14]\ntheorem rank_height_count_asymptotic (r : ℕ) (h₁ : 1 ≤ r) (h₂ : r ≤ 20) :\n    ∃ f : ℕ → ℝ, atTop.Tendsto f (𝓝 0) ∧\n      ∀ H : ℕ, 1 < H → {E ∈ heightLE H | r ≤ E.rank}.ncard = (H : ℝ) ^ ((21 - r) / 24 + f H)",
