  "title": "conjecture_1_3_to_2_3",
  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 6]\ntheorem conjecture_1_3_to_2_3 : answer(sorry) ↔ ∀ (P : Type) [Finite P] [PartialOrder P]\n    (not_total : ¬ Std.Total (α := P) (· ≤ ·)) (total_ext : Set <| OrderHom P ℕ)\n    (total_ext_def : ∀ σ, σ ∈ total_ext ↔ Set.range σ = Set.Icc 1 (Nat.card P)),\n    ∃ x y : P, ({σ ∈ total_ext | σ x < σ y}.ncard / total_ext.ncard : ℚ)\n      ∈ Set.Icc (1/3) (2/3)",
    "language_version": "Lean 4.27.0",
