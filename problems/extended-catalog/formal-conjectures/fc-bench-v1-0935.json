  "title": "exists_magic_square_squares",
  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 11]\ntheorem exists_magic_square_squares :\n    answer(sorry) ↔ ∃ m : Fin 3 → Fin 3 → ℕ, ∃ t : ℕ,\n       m.Injective2 ∧\n       (∀ i j, 0 < (m i j) ∧ IsSquare (m i j)) ∧\n       (∀ i, ∑ j, m i j = t) ∧\n       (∀ j, ∑ i, m i j = t) ∧\n       m 0 0 + m 1 1 + m 2 2 = t ∧\n       m 0 2 + m 1 1 + m 2 0 = t",
    "language_version": "Lean 4.27.0",
