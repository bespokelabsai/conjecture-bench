  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 28 52]\ntheorem green_85 :\n  answer(sorry) ↔ ∃ c > 0, ∀ A : Set (ℝ × ℝ),\n    IsOpen A →\n    A ⊆ Icc 0 1 ×ˢ Icc 0 1 →\n    A.Nonempty →\n    let α := (volume A).toReal\n    ∃ x₁ x₂ y₁ y₂,\n      {(x₁, y₁), (x₂, y₁), (x₂, y₂), (x₁, y₂)} ⊆ A ∧\n      c * α ^ 2 ≤ |x₁ - x₂| * |y₁ - y₂|",
