  "title": "erdos_137.variants.multiple_powerful_factors",
  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 11]\ntheorem erdos_137.variants.multiple_powerful_factors (k : ℕ) : ∀ᶠ n in Filter.atTop,\n    ∀ (m : ℕ) (hm : 0 < m),\n    letI N := ∏ x ∈ Finset.Ioc m (m + n), x\n    ∃ P : Finset ℕ, P.card = k ∧ ∀ p ∈ P, p.Prime ∧\n    p ∣ N ∧ ¬ p ^ 2 ∣ N",
