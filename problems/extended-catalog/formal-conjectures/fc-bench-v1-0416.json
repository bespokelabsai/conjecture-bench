    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 5]\ntheorem erdos_64 :\n    answer(sorry) ↔ ∀ (V : Type*) (G : SimpleGraph V) [Fintype V] [DecidableRel G.Adj],\n        G.minDegree ≥ 3 → ∃ (k : ℕ) (v : V) (c : G.Walk v v),\n            k ≥ 2 ∧ c.IsCycle ∧ c.length = 2^k",
