    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 11]\ntheorem green_62 :\n    answer(sorry) ↔\n      ∀ᶠ p in atTop, p.Prime →\n        let A := (Finset.range p).filter Nat.Prime\n        ∀ x : ℕ, 1 ≤ x ∧ x < p →\n          ∃ a₁ ∈ A, ∃ a₂ ∈ A, (x : ZMod p) = (a₁ * a₂ : ZMod p)",
