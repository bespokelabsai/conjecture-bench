  "title": "lemoine_conjecture_extension",
  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 11]\ntheorem lemoine_conjecture_extension (n : ℕ) (hn : 8 < n) (odd : Odd n) :\n    ∃ (p q r s a b : ℕ), OddPrime p ∧ OddPrime q ∧ OddPrime r ∧ OddPrime s ∧\n    p + 2 * q = n ∧ 2 + p * q = 2 ^ a + r ∧ 2 * p + q = 2 ^ b + s",
