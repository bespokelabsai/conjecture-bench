  "title": "exists_semi_magic_square_cubes",
  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 5 11]\ntheorem exists_semi_magic_square_cubes :\n    answer(sorry) ↔ ∃ m : Fin 3 → Fin 3 → ℕ, ∃ t : ℕ,\n       m.Injective2 ∧\n       (∀ i j, ∃ n : ℕ, 0 < n ∧ m i j = n ^ 3) ∧\n       (∀ i, ∑ j, m i j = t) ∧\n       (∀ j, ∑ i, m i j = t)",
