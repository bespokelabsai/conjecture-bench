    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 5]\ntheorem union_closed.variants.cardinality_even_of_union_closed_tight\n    [Nonempty n] (hA : A ≠ {∅} ∧ A ≠ ∅) (hA : IsUnionClosed A)\n    (UCC_tight : ∀ i, #{x ∈ A | i ∈ x} = (1 / 2 : ℝ) * #A) :\n    ∃ k, #A = 2 ^ k",
