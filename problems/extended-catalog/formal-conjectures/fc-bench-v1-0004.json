  "title": "independentDominationEven",
  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 5]\ntheorem independentDominationEven (hIso : 0 < G.minDegree) (hEven : Even G.maxDegree) :\n    let D := G.maxDegree\n    let i := G.indepDominationNumber\n    let n := Fintype.card V\n    (D + 2)^2 * i ≤ (D^2 + 4) * n",
