  "title": "oppermann_conjecture",
  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 11]\ntheorem oppermann_conjecture (x : ℕ) (hx : 2 ≤ x) :\n    (∃ p ∈ Ioo (x * (x - 1)) (x^2), p.Prime) ∧\n    (∃ p ∈ Ioo (x^2) (x * (x + 1)), p.Prime)",
