  "title": "reed_omega_delta_chi_conjecture_for_finite_graphs",
  "statement": {
    "representation": "lean4-declaration",
    "text": "@[category research open, AMS 5]\ntheorem reed_omega_delta_chi_conjecture_for_finite_graphs :\n  ∀ {V : Type} [Fintype V] [DecidableEq V] (G : SimpleGraph V) [DecidableRel G.Adj],\n    let χ := G.chromaticNumber\n    let ω := G.cliqueNum\n    let Δ := G.maxDegree\n    2 * χ ≤ ω + Δ + 2",
